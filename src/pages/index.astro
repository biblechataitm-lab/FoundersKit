---
import Layout from '@/layouts/Layout.astro';
import { HeroLanding } from '@/components/landing/HeroLanding';
import { CategoryChips } from '@/components/CategoryChips';
import { ProductListWithPagination } from '@/components/ProductListWithPagination';
import Sidebar from '@/components/Sidebar.astro';
import { FeaturesSection } from '@/components/landing/FeaturesSection';
import { StatsSection } from '@/components/landing/StatsSection';
import { CTASection } from '@/components/landing/CTASection';
import { getProducts, getSiteConfig } from '@/lib/ads';

export const prerender = true;

const config = await getSiteConfig();
const siteName = config?.name || 'FoundersKit';
const { products, nextCursor } = await getProducts();
---

<Layout title="FoundersKit — The Independent Founder’s Stack & Almanac" description="The essential software, incorporation rails, cap-table engines, and growth tools for technology founders.">
  <div class="theme-founderskit">
    <!-- Bespoke MotionSites Hero -->
    <HeroLanding client:load />

    <!-- Live Niche Directory Section -->
    <section class="home-directory-section" id="directory">
      <div class="container main-layout">
        <div class="directory-main-col">
          <CategoryChips client:load />
          <div class="section-header">
            <div>
              <h2 class="section-title">Trending &amp; Featured on FoundersKit</h2>
              <p class="section-subtitle">The essential software, incorporation rails, cap-table engines, and growth tools for technology founders.</p>
            </div>
          </div>
          <ProductListWithPagination
            client:load
            initialProducts={products}
            initialNextCursor={nextCursor}
            emptyTitle="No tools found"
          />
        </div>
        <Sidebar />
      </div>
    </section>

    <!-- Bespoke Niche Features Section -->
    <FeaturesSection client:visible />

    <!-- Traction Stats Counter -->
    <StatsSection client:visible />

    <!-- Launch CTA -->
    <CTASection client:visible />
  </div>
</Layout>
